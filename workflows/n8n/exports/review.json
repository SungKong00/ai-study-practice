    {
      "name": "게시 근거 대조",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        -550
      ],
      "parameters": {
        "jsCode": "const draft=$('요청 조회').first().json, current=$json, form=$('검토 입력').first().json;\nif (!current.scope_digest || !current.commit || !current.repo) throw Error('최신 상품 근거 누락');\nif (form.token !== draft.review_token || (draft.target_repo && draft.target_repo !== current.repo)) throw Error('판본 또는 저장소 불일치');\nreturn [{json:{...draft,verified_commit:current.commit,recheck:current.scope_digest !== draft.scope_digest || form.decision === '수정 후 재검토'}}];"
      },
      "id": "dad89767-d4a7-490f-893d-5df5def146bd"
    },
