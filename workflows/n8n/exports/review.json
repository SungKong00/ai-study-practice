        "responseMode": "lastNode",
        "options": {
          "path": "team-review"
        },
        "formDescription": "대기 목록에서 요청 ID를 찾아 초안 보기를 선택하세요. 제목·본문을 확인한 뒤 같은 폼에 검토 코드를 입력해 처리합니다."
      },
      "webhookId": "team-review",
      "id": "TeamRequestReviewNode01"
    },
    {
      "name": "요청 조회",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.*, $1::text AS wanted\nFROM (SELECT 1) s LEFT JOIN team_request t ON t.request_id=$1",
        "options": {
          "queryReplacement": "={{ [String($json.request_id).trim()] }}"
        }
      },
      "id": "TeamRequestReviewNode02"
    },
    {
      "name": "검토 결정 요청",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ ['pending','rejected'].includes($json.state) && ['승인','거절','수정 후 재검토'].includes($('검토 입력').first().json.decision) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "TeamRequestReviewNode03"
    },
    {
      "name": "검토 결정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -200
      ],
      "parameters": {
        "jsCode": "const form = $('검토 입력').first().json;\nconst draft = $json;\nconst normalize = value => String(value ?? '').replace(/\\r\\n/g, '\\n').trim();\nconst token = normalize(form.token);\nif (token !== draft.review_token) throw Error('최신 초안을 열어 검토 코드를 확인하세요.');\nconst edit = form.decision === '수정 후 재검토';\nif (!edit && (normalize(form.title) || normalize(form.body))) throw Error('제목 또는 본문을 바꾸려면 수정 후 재검토를 선택하세요.');\nif (form.decision === '승인' && draft.state !== 'pending') throw Error('거절된 초안은 수정 후 다시 검토하세요.');\nconst footer = '\\n\\n명세 근거 (' + draft.spec_sha + ')\\n' + draft.evidence + '\\n\\n<!-- team-request:' + draft.request_id + ' -->';\nconst title = (edit && normalize(form.title)) || draft.title;\nconst body = edit && normalize(form.body) ? normalize(form.body) + footer : draft.body;\nif (title.length > 180 || body.length > 6000) throw Error('제목은 180자, 근거 포함 본문은 6000자 이내로 작성하세요.');\nconst state = edit ? 'pending' : form.decision === '승인' ? 'publishing' : 'rejected';\nreturn [{json:{id:draft.request_id, token, title, body, state}}];"
      },
      "id": "TeamRequestReviewNode04"
    },
    {
      "name": "결정 반영",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1200,
        -200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH changed AS (\n  UPDATE team_request SET title=$3, body=$4, state=$5,\n    review_token=gen_random_uuid(), revision=revision+1, reviewed_at=now()\n  WHERE request_id=$1 AND review_token=$2::uuid AND state IN ('pending','rejected')\n  RETURNING request_id, state, title, body\n) SELECT changed.* FROM (SELECT 1) s LEFT JOIN changed ON true",
        "options": {
          "queryReplacement": "={{ [$json.id,$json.token,$json.title,$json.body,$json.state] }}"
        }
      },
      "id": "TeamRequestReviewNode05"
    },
    {
      "name": "등록 권한 획득",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.state === 'publishing' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "TeamRequestReviewNode06"
    },
    {
      "name": "승인한 이슈 생성",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        1680,
        -400
      ],
      "parameters": {
        "owner": {
          "__rl": true,
          "mode": "list",
          "value": "SungKong00"
        },
        "repository": {
          "__rl": true,
          "mode": "list",
          "value": "ai-study-practice"
        },
        "resource": "issue",
        "operation": "create",
        "title": "={{ $json.title }}",
        "body": "={{ $json.body }}",
        "labels": [],
        "assignees": []
      },
      "retryOnFail": false,
      "onError": "continueRegularOutput",
      "id": "TeamRequestReviewNode07"
    },
    {
      "name": "등록 응답",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        -400
      ],
      "parameters": {
        "jsCode": "const id = $('결정 반영').first().json.request_id;\nconst number = Number.isSafeInteger($json.number) && $json.number > 0 ? $json.number : null;\nreturn [{json:{id, number}}];"
      },
      "id": "TeamRequestReviewNode08"
    },
    {
      "name": "이슈 번호 확인",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2160,
        -400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.number !== null }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "TeamRequestReviewNode09"
    },
    {
      "name": "이슈 연결",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        2400,
        -200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE team_request SET state='published', issue_number=$2\nWHERE request_id=$1 AND (state='publishing' OR (state='published' AND issue_number=$2))\nRETURNING request_id, state, issue_number",
        "options": {
          "queryReplacement": "={{ [$json.id,$json.number] }}"
        }
      },
      "id": "TeamRequestReviewNode10"
    },
    {
      "name": "기존 이슈 대조",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.state === 'publishing' && $('검토 입력').first().json.decision === '기존 이슈 연결' && Number($('검토 입력').first().json.issue_number) > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
