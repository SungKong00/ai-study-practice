      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE team_request SET title=$3,body=$4,category=$5,state=CASE WHEN $5='새 기능' THEN 'pending' ELSE 'answered' END,answer=$6,evidence=$7,spec_sha=$8,basis_commit=$8,verified_commit=$8,scope_digest=$9,target_repo=$10,evidence_items=$11::jsonb,draft_fields=NULL,review_token=gen_random_uuid(),revision=revision+1 WHERE request_id=$1 AND review_token=$2::uuid AND state IN ('pending','rejected') RETURNING *",
        "options": {
          "queryReplacement": "={{ [$json.id,$json.token,$json.title,$json.body,$json.category,$json.answer,$json.evidence,$json.sha,$json.digest,$json.repo,JSON.stringify($json.items)] }}"
