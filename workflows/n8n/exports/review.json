    {
      "name": "등록 내용 대조",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "jsCode": "const draft = $('요청 조회').first().json;\nif ($json.pull_request || $json.title !== draft.title || $json.body !== draft.body || !Number.isSafeInteger($json.number)) {\n  throw Error('승인한 제목·본문과 기존 이슈가 일치하는지 확인하세요.');\n}\nreturn [{json:{id:draft.request_id, number:$json.number}}];"
      },
      "id": "TeamRequestReviewNode13"
    },
    {
      "name": "검토 상태",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "const action = $('검토 입력').first().json.decision;\nconst state = $json.state ?? ($json.id ? 'publishing' : null);\nlet message;\nif (action === '초안 보기' && ['pending','rejected'].includes(state)) {\n  message = [$json.request_id + ' · 버전 ' + $json.revision, $json.title, $json.body,\n    '검토 코드: ' + $json.review_token, '담당자 검토 폼에 이 코드와 처리할 동작을 입력하세요.'].join('\\n\\n');\n} else {\n  const messages = {\n    answered:'명세 답변으로 끝난 요청입니다.', pending:'초안이 대기 중입니다. 초안 보기에서 검토 코드를 확인하세요.',\n    rejected:'거절했습니다. 수정 후 재검토할 수 있습니다.', published:'연결된 이슈 번호: ' + $json.issue_number,\n    publishing:'생성 결과 확인 중입니다. GitHub에서 요청 ID로 기존 이슈를 찾아 번호와 함께 기존 이슈 연결을 선택하세요.'\n  };\n  message = messages[state] ?? '요청이 없거나 다른 담당자가 먼저 처리했습니다. 초안을 다시 조회하세요.';\n}\nreturn [{json:{...$json, state, message}}];"
      },
      "id": "TeamRequestReviewNode14"
    },
    {
      "name": "처리 결과",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "처리 결과",
        "completionMessage": "={{ '<pre>' + String($json.message).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</pre>' }}",
        "options": {}
      },
      "id": "TeamRequestReviewNode15"
    },
