    {
      "name": "요청 조회",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.*, $1::text AS wanted\nFROM (SELECT 1) s LEFT JOIN team_request t ON t.request_id=$1",
        "options": {
          "queryReplacement": "={{ [String($json.request_id).trim()] }}"
        }
      },
      "id": "TeamRequestReviewNode02"
