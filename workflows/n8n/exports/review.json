      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        480,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(string_agg(request_id || ' · ' || label || ' · ' || title, E'\\n' ORDER BY created_at, request_id), '대기 중인 요청이 없습니다.') AS message\nFROM (SELECT request_id, title, created_at,\n    CASE WHEN state='pending' THEN '승인 대기' ELSE '생성 결과 확인' END AS label\n  FROM team_request WHERE state IN ('pending','publishing')\n  ORDER BY created_at, request_id LIMIT 30) AS queue",
        "options": {}
      },
      "id": "TeamRequestReviewNode18"
