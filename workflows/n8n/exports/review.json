      ],
      "parameters": {
        "jsCode": "const current=$('최신 상품 근거').first().json, draft=$('요청 조회').first().json, form=$('검토 입력').first().json;\nconst result=JSON.parse($json.choices[0].message.content);\nconst doc=Object.keys(current.docs).find(p=>result.evidence?.trim() && current.docs[p].includes(result.evidence));\nif (!['새 기능','이미 지원','확인 필요'].includes(result.category) || !doc || !result.code_quote?.trim() || !current.code[result.code_file]?.includes(result.code_quote)) throw Error('재판정 근거 불완전');\nconst title=(form.title || draft.title).trim();\nconst input=(form.body || draft.body).split('\\n\\n구현 근거')[0].split('\\n\\n명세 근거')[0].trim();\nconst source=draft.body.match(/요청 대화 https:\\/\\/discord\\.com\\/channels\\/\\d+\\/\\d+/)?.[0];\nconst body=input+'\\n\\n구현 근거\\n'+result.code_file+' @ '+current.commit+'\\n'+result.code_quote+(source?'\\n\\n'+source:'')+'\\n\\n명세 근거 ('+current.commit+')\\n'+result.evidence+'\\n\\n<!-- team-request:'+draft.request_id+' -->';\nif(!title || title.length>180 || body.length>6000) throw Error('초안 길이 오류');\nconst items=[{path:doc,quote:result.evidence},{path:result.code_file,quote:result.code_quote}];\nconst originalItems=draft.evidence_items;\nconst canPublish=form.decision==='승인' && draft.basis_commit && draft.target_repo===current.repo &&\n  draft.category==='새 기능' && result.category==='새 기능' && Array.isArray(originalItems) &&\n  originalItems.length===items.length && items.every(i=>originalItems.some(o=>o.path===i.path && o.quote===i.quote));\nreturn [{json:{canPublish,id:draft.request_id,token:form.token,title,body,category:result.category,answer:result.answer,evidence:result.evidence,sha:current.commit,digest:current.scope_digest,repo:current.repo,items:[{path:doc,quote:result.evidence},{path:result.code_file,quote:result.code_quote}]}}];"
      },
      "id": "53eacd9d-0d0f-4b22-8782-91d1413331f0"
