    {
      "name": "기존 이슈 읽기",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "owner": {
          "__rl": true,
          "mode": "list",
          "value": "SungKong00"
        },
        "repository": {
          "__rl": true,
          "mode": "list",
          "value": "ai-study-practice"
        },
        "resource": "issue",
        "operation": "get",
        "issueNumber": "={{ Number($('검토 입력').first().json.issue_number) }}"
