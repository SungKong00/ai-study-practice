      "id": "TeamRequestReviewNode03"
    },
    {
      "name": "검토 결정",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -200
      ],
      "parameters": {
        "jsCode": "const form = $('검토 입력').first().json;\nconst draft = $json;\nconst normalize = value => String(value ?? '').replace(/\\r\\n/g, '\\n').trim();\nconst token = normalize(form.token);\nif (token !== draft.review_token) throw Error('최신 초안을 열어 검토 코드를 확인하세요.');\nconst edit = form.decision === '수정 후 재검토';\nif (!edit && (normalize(form.title) || normalize(form.body))) throw Error('제목 또는 본문을 바꾸려면 수정 후 재검토를 선택하세요.');\nif (form.decision === '승인' && draft.state !== 'pending') throw Error('거절된 초안은 수정 후 다시 검토하세요.');\nconst footer = '\\n\\n명세 근거 (' + draft.spec_sha + ')\\n' + draft.evidence + '\\n\\n<!-- team-request:' + draft.request_id + ' -->';\nconst title = (edit && normalize(form.title)) || draft.title;\nconst body = edit && normalize(form.body) ? normalize(form.body) + footer : draft.body;\nif (title.length > 180 || body.length > 6000) throw Error('제목은 180자, 근거 포함 본문은 6000자 이내로 작성하세요.');\nconst state = edit ? 'pending' : form.decision === '승인' ? 'publishing' : 'rejected';\nreturn [{json:{id:draft.request_id, token, title, body, state, verified_commit:draft.verified_commit ?? null}}];"
      },
      "id": "TeamRequestReviewNode04"
    },
    {
      "name": "결정 반영",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1200,
        -200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH changed AS (\n  UPDATE team_request SET verified_commit=$6, title=$3, body=$4, state=$5,\n    review_token=gen_random_uuid(), revision=revision+1, reviewed_at=now()\n  WHERE request_id=$1 AND review_token=$2::uuid AND state IN ('pending','rejected')\n  RETURNING request_id, state, title, body\n) SELECT changed.* FROM (SELECT 1) s LEFT JOIN changed ON true",
        "options": {
          "queryReplacement": "={{ [$json.id,$json.token,$json.title,$json.body,$json.state,$json.verified_commit] }}"
        }
      },
      "id": "TeamRequestReviewNode05"
    },
    {
