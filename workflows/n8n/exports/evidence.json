    },
    {
      "name": "상품 루트",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        260
      ],
      "parameters": {
        "jsCode": "const roots=$json.tree?.filter(e=>e.type==='tree' && ['openspec','src'].includes(e.path));\nif (!roots || roots.length!==2 || $json.truncated) throw Error('상품 루트 조회 불완전');\nreturn roots.map(e=>({json:{path:e.path,sha:e.sha}}));"
      },
      "id": "304ca06a-469b-4014-9514-a6aaf802cecb"
    },
    {
      "name": "하위 트리",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        260
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/SungKong00/ai-study-practice/git/trees/{{ $json.sha }}?recursive=1",
        "options": {
          "timeout": 15000
