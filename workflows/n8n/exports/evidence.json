    {
      "name": "캐시 조회",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH expired AS (DELETE FROM team_evidence_cache WHERE last_used < now()-interval '7 days'), hit AS (\nUPDATE team_evidence_cache SET last_used=now() WHERE repo=$1 AND commit_sha=$2 AND scope='product-v1' AND last_used >= now()-interval '7 days' RETURNING snapshot)\nSELECT $1::text AS repo,$2::text AS commit,(SELECT snapshot FROM hit) AS snapshot",
        "options": {
          "queryReplacement": "={{ ['SungKong00/ai-study-practice',$json.sha] }}"
        }
      },
      "id": "c27d267d-2bae-4fcc-9cb7-971245c3e3c3"
    },
    {
      "name": "캐시 있음",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.snapshot != null }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "611e32f3-69ed-4d77-b551-578933535374"
    },
    {
      "name": "캐시 반환",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
