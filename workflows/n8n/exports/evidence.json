      },
      "id": "d6cbfa94-54a8-44b6-a2a4-c48041bb4432"
    },
    {
      "name": "상품 트리 결합",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        260
      ],
      "parameters": {
        "jsCode": "const roots=$('상품 루트').all(), tree=[];\nfor (const [i,{json:result}] of $input.all().entries()) {\n  if (result.truncated || result.sha!==roots[i].json.sha) throw Error('제품 하위 목록 불완전');\n  for (const item of result.tree) tree.push({...item,path:roots[i].json.path+'/'+item.path});\n}\nreturn [{json:{tree,truncated:false}}];"
      },
      "id": "b30a6fd4-804a-46d2-91a2-8630c10f4fab"
    }
