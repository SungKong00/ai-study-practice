      ],
      "parameters": {
        "jsCode": "return [{json:$json.snapshot}];"
      },
      "id": "859434bb-6044-4f03-8e3d-e601ec8c443d"
    },
    {
      "name": "커밋 트리",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/SungKong00/ai-study-practice/git/trees/{{ $('기준 커밋').first().json.commit.tree.sha }}?recursive=1",
        "options": {
          "timeout": 15000
        }
      },
      "id": "d6b1f885-75a6-4958-9fba-3eefd89bf760"
    },
    {
      "name": "허용 경로",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "if ($json.truncated || !Array.isArray($json.tree)) throw Error('상품 근거 목록 불완전');\nconst paths = $json.tree.filter(e => e.type === 'blob' && e.mode === '100644' && (\n  /^openspec\\/specs\\/product-[^/]+\\/spec\\.md$/.test(e.path) ||\n  /^src\\/(main|test)\\/java\\/com\\/example\\/shop\\/product\\/.+\\.java$/.test(e.path) ||\n  ['src/main/java/com/example/shop/JsonConfiguration.java','src/main/resources/application.properties'].includes(e.path)));\nif (!paths.some(e => e.path.startsWith('openspec/')) || !paths.some(e => e.path.startsWith('src/main/java/'))) throw Error('상품 근거 누락');\nreturn paths.map(e => ({json:{path:e.path,sha:e.sha}}));"
      },
      "id": "6f31ea72-6aa2-4104-8bda-ee08e953e4fe"
    },
    {
      "name": "근거 파일",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/SungKong00/ai-study-practice/git/blobs/{{ $json.sha }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "748d8800-86d0-4d5b-abd0-c3f6c3a13bb8"
    },
    {
      "name": "목차 구성",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const paths = $('허용 경로').all();\nconst {commit,repo} = $('캐시 조회').first().json;\nconst docs={},code={},tests={},index=[];\nfor (const [i,item] of $input.all().entries()) {\n  const {path,sha}=paths[i].json;\n  const blob=item.json;\n  if (blob.sha !== sha || blob.encoding !== 'base64') throw Error('파일 버전 불일치');\n  let content=Buffer.from(blob.content,'base64').toString('utf8');\n  if (path.endsWith('application.properties')) content=content.split('\\n').filter(s => /^spring\\.(mvc\\.problemdetails\\.enabled|jackson\\.(deserialization\\.accept-float-as-int|mapper\\.allow-coercion-of-scalars)(?==))/.test(s)).join('\\n');\n  if (path.startsWith('openspec/')) {\n    docs[path]=content;\n    index.push({path,sha,purpose:content.match(/## Purpose\\s+([\\s\\S]*?)(?=\\n## |$)/)?.[1]?.trim(),headings:content.split('\\n').filter(s => /^#{3,4} (Requirement|Scenario):/.test(s))});\n  } else if(path.startsWith('src/test/')) tests[path]=content;\n  else code[path]=content;\n}\nreturn [{json:{repo,commit,docs,code,tests,index}}];"
      },
      "id": "6d22a34d-3e0c-473d-9f8c-d1a47c72f8df"
    },
    {
      "name": "캐시 저장",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO team_evidence_cache(repo,commit_sha,scope,snapshot) VALUES ($1,$2,'product-v1',$3::jsonb || jsonb_build_object('scope_digest',md5((($3::jsonb)-'commit'-'repo')::text)))\nON CONFLICT(repo,commit_sha,scope) DO UPDATE SET last_used=now() RETURNING snapshot",
        "options": {
          "queryReplacement": "={{ [$json.repo,$json.commit,JSON.stringify($json)] }}"
        }
      },
      "id": "ee8c90ea-d5fe-4c42-a5ba-ccf11ce8ef5d"
    },
    {
      "name": "근거 반환",
