{
  "name": "팀 요청 · Discord 연결",
  "id": "TeamRequestDiscord",
  "nodes": [
    {
      "name": "Discord 연결",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        -420
      ],
      "parameters": {
        "inputSource": "passthrough"
      },
