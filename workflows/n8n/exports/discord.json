    },
    {
      "name": "Discord 입력",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -420
      ],
      "parameters": {
        "jsCode": "const b = $json.body;\nif (!b || !/^discord:[0-9]{15,22}$/.test(b.request_id) || !['draft','status','approve','edit'].includes(b.action)) throw Error('잘못된 요청입니다.');\nconst base = {source:'discord', request_id:b.request_id, decision:b.action === 'approve' ? '승인' : b.action === 'edit' ? '수정 후 재검토' : '초안 보기', token:b.token ?? ''};\nif (b.action === 'edit') return [{json:{...base,title:b.title,body:b.body}}];\nif (b.action !== 'draft') return [{json:base}];\nfor (const [key, limit] of Object.entries({title:180, body:4600, evidence:500, request_text:2000})) {\n  if (typeof b[key] !== 'string' || !b[key].trim() || b[key].length > limit) throw Error('초안 필드를 확인하세요: ' + key);\n}\nif (!/^[0-9a-f]{40}$/.test(b.spec_sha)) throw Error('명세 버전을 확인하세요.');\nconst body = b.body + '\\n\\n명세 근거 (' + b.spec_sha + ')\\n' + b.evidence + '\\n\\n<!-- team-request:' + b.request_id + ' -->';\nreturn [{json:{...base, draft:true, title:b.title, body, evidence:b.evidence, basis_commit:b.basis_commit ?? null, previous_token:b.previous_token ?? null, scope_digest:b.scope_digest ?? null, target_repo:b.target_repo ?? null, draft_fields:b.draft_fields ?? null, evidence_items:b.evidence_items ?? null, spec_sha:b.spec_sha, request_text:b.request_text}}];"
      },
      "id": "69e63cac-5359-4985-b854-2a6a1d7e0de3"
    },
    {
      "name": "Discord 초안 여부",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        -420
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.draft === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9e1a554a-f7cf-4a46-bc29-e8b5c6dc0255"
    },
    {
      "name": "Discord 초안 보관",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        660,
        -520
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO team_request (request_id,request_text,spec_sha,category,evidence,answer,title,body,state,basis_commit,target_repo,draft_fields,evidence_items,scope_digest)\nVALUES ($1,$2,$3,'새 기능',$4,'Discord 대화에서 구체화',$5,$6,'pending',$7,$8,$9::jsonb,$10::jsonb,$11)\nON CONFLICT (request_id) DO UPDATE SET request_text=excluded.request_text,spec_sha=excluded.spec_sha,\ncategory=excluded.category,evidence=excluded.evidence,answer=excluded.answer,title=excluded.title,body=excluded.body,state='pending',\nbasis_commit=excluded.basis_commit,target_repo=excluded.target_repo,draft_fields=excluded.draft_fields,\nevidence_items=excluded.evidence_items,scope_digest=excluded.scope_digest,verified_commit=NULL,\nrevision=team_request.revision+1,review_token=gen_random_uuid()\nWHERE team_request.state='answered' AND team_request.review_token=$12::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.request_id,$json.request_text,$json.spec_sha,$json.evidence,$json.title,$json.body,$json.basis_commit,$json.target_repo,JSON.stringify($json.draft_fields),JSON.stringify($json.evidence_items),$json.scope_digest,$json.previous_token] }}"
        }
      },
      "id": "8716e99f-3003-4787-a6a2-85a69ce6cbba",
      "alwaysOutputData": true
    },
    {
      "name": "저장 후 조회",
